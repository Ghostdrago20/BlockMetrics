  <style>
    body {
      font-family: 'IBM Plex Sans', sans-serif;
    }
    
    /* Custom scrollbar for a better dark-theme look */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #1f2937; /* bg-gray-800 */
    }
    ::-webkit-scrollbar-thumb {
      background: #4b5563; /* bg-gray-600 */
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #6b7280; /* bg-gray-500 */
    }

    /* Animation for price changes */
    @keyframes flash-green-bg {
      0% { background-color: rgba(74, 222, 128, 0.3); } /* green-400 with opacity */
      100% { background-color: transparent; }
    }
    @keyframes flash-red-bg {
      0% { background-color: rgba(248, 113, 113, 0.3); } /* red-400 with opacity */
      100% { background-color: transparent; }
    }
    .flash-green {
      animation: flash-green-bg 750ms ease-out;
    }
    .flash-red {
      animation: flash-red-bg 750ms ease-out;
    }

    /* Modal Animations */
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .animate-fade-in {
      animation: fade-in 200ms ease-out forwards;
    }

    @keyframes slide-up {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .animate-slide-up {
      animation: slide-up 300ms ease-out forwards;
    }

    /* Hero background */
    .hero-bg {
        background-color: #0a0a0a;
        background-image:
            radial-gradient(at 27% 37%, hsla(215, 98%, 61%, 0.1) 0px, transparent 50%),
            radial-gradient(at 97% 21%, hsla(125, 98%, 72%, 0.1) 0px, transparent 50%),
            radial-gradient(at 52% 99%, hsla(355, 98%, 61%, 0.1) 0px, transparent 50%),
            radial-gradient(at 10% 29%, hsla(256, 96%, 61%, 0.1) 0px, transparent 50%),
            radial-gradient(at 97% 96%, hsla(38, 60%, 72%, 0.1) 0px, transparent 50%),
            radial-gradient(at 33% 50%, hsla(222, 67%, 73%, 0.1) 0px, transparent 50%),
            radial-gradient(at 79% 53%, hsla(343, 68%, 73%, 0.1) 0px, transparent 50%);
    }

    /* Floating shapes animation */
    @keyframes float {
        0% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(10deg); }
        100% { transform: translateY(0px) rotate(0deg); }
    }
    .shape {
        position: absolute;
        border-radius: 50%;
        background: rgba(251, 191, 36, 0.1); /* yellow-400 with opacity */
        animation: float 6s ease-in-out infinite;
    }
  </style>
